# BloodConnect Backend Environment Variables
PORT=8000
FLASK_ENV=development
FLASK_DEBUG=True

# MongoDB Atlas Connection
MONGO_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@lifeline.hpq3jzn.mongodb.net/lifeline?retryWrites=true&w=majority
DB_NAME=lifeline

# JWT Authentication
JWT_SECRET=change_this_to_a_secure_random_secret_in_production
JWT_EXPIRES_IN=86400

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# Email Notifications (Optional for development - falls back to console logging)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@bloodconnect.org
