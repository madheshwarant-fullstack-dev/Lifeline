# =================================================================
# Lifeline Full-Stack Environment Configuration Template
# NOTE: Never commit actual credentials, passwords, or secrets.
# =================================================================

# ----------------- Backend Environment Variables (backend/.env) -----------------
PORT=8000
FASTAPI_ENV=production

# MongoDB Atlas Connection
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<YOUR_ATLAS_USERNAME>:<YOUR_ATLAS_PASSWORD>@lifeline.hpq3jzn.mongodb.net/lifeline?retryWrites=true&w=majority
DB_NAME=lifeline

# JWT Security
JWT_SECRET=your_super_secret_jwt_key_replace_in_production
JWT_EXPIRES_IN=86400

# CORS Allowed Frontend Origin (Local or Deployed Vercel URL)
FRONTEND_URL=http://localhost:5173

# Email Notifications (Optional for development - falls back to terminal simulation)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@lifeline.org

# ----------------- Frontend Environment Variables (frontend/.env) ----------------
# Local development: http://localhost:8000
# Deployed production: https://<your-render-backend-name>.onrender.com
VITE_API_BASE_URL=http://localhost:8000

